  "aaa": {
    "$description": "AAA-* size, spacing and layout variants (WCAG 2.2 AAA 1.4.8 Visual Presentation, 2.5.5 Target Size, 2.4.13 Focus Appearance). Use with the AAA themes, or alone where text must be easier to read.",
    "type": {
