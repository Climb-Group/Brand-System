      },
      "body-line-height": {
        "$value": 1.6
      },
      "lead-line-height": {
        "$value": 1.6
      },
      "heading-line-height": {
        "$value": 1.25,
        "$description": "Headings at least 1.2 so wrapped lines stay apart."
      },
      "paragraph-spacing": {
