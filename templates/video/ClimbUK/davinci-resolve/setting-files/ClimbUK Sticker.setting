{
	Tools = ordered() {
		Climb_Sticker = MacroOperator {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Label", Source = "StyledText", Name = "Sticker text", Default = "MAIN STAGE", },
				Input2 = InstanceInput { SourceOp = "Tag", Source = "Width", Name = "Sticker width", },
				Input3 = InstanceInput { SourceOp = "MergeTag", Source = "Center", Name = "Position", },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "MergeTag", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Canvas = Background {
				Inputs = {
					Width = Input { Value = 3840, },
					Height = Input { Value = 2160, },
					UseFrameFormatSettings = Input { Value = 0, },
					TopLeftRed = Input { Value = 0, },
					TopLeftGreen = Input { Value = 0, },
					TopLeftBlue = Input { Value = 0, },
					TopLeftAlpha = Input { Value = 0, },
				},
			},
				Tag = Background {
				Inputs = {
					Width = Input { Value = 900, },
					Height = Input { Value = 170, },
					UseFrameFormatSettings = Input { Value = 0, },
					TopLeftRed = Input { Value = 0.909804, },
					TopLeftGreen = Input { Value = 0.443137, },
					TopLeftBlue = Input { Value = 0.164706, },
					TopLeftAlpha = Input { Value = 1, },
				},
			},
				Label = TextPlus {
				Inputs = {
					Width = Input { Value = 900, },
					Height = Input { Value = 170, },
					UseFrameFormatSettings = Input { Value = 0, },
					StyledText = Input { Value = "MAIN STAGE", },
					Font = Input { Value = "Montserrat", },
					Style = Input { Value = "Black", },
					Size = Input { Value = 0.5647, },
					Red1 = Input { Value = 1, },
					Green1 = Input { Value = 1, },
					Blue1 = Input { Value = 1, },
					Alpha1 = Input { Value = 1, },
				},
			},
				TagLabel = Merge {
				Inputs = {
					Background = Input { SourceOp = "Tag", Source = "Output", },
					Foreground = Input { SourceOp = "Label", Source = "Output", },
				},
			},
				PopSize = BezierSpline {
				SplineColor = { Red = 232, Green = 113, Blue = 42 },
				KeyFrames = {
					[0] = { 0.6, RH = { 0.64, 1.06 } },
					[4] = { 1.06, RH = { 4.96, 1 }, LH = { 1.2, 1.06 } },
					[10] = { 1, LH = { 5.8, 1 } }
				}
			},
				Pop = Transform {
				Inputs = {
					Input = Input { SourceOp = "TagLabel", Source = "Output", },
					Angle = Input { Value = 4, },
					Size = Input { SourceOp = "PopSize", Source = "Value", },
				},
			},
				MergeTagBlend = BezierSpline {
				SplineColor = { Red = 232, Green = 113, Blue = 42 },
				KeyFrames = {
					[0] = { 0, RH = { 0.48, 1 } },
					[3] = { 1, LH = { 0.9, 1 } }
				}
			},
				MergeTag = Merge {
				Inputs = {
					Background = Input { SourceOp = "Canvas", Source = "Output", },
					Foreground = Input { SourceOp = "Pop", Source = "Output", },
					Center = Input { Value = { 0.21094, 0.82176 }, },
					Blend = Input { SourceOp = "MergeTagBlend", Source = "Value", },
				},
			}
			},
		},
	},
	ActiveTool = "Climb_Sticker"
}
