{
	Tools = ordered() {
		ClimbGroup_Sticker = MacroOperator {
			CtrlWZoom = false,
			NameSet = true,
			Inputs = ordered() {
				Input1 = InstanceInput { SourceOp = "Canvas", Source = "Variant", Name = "Colour variant", Default = 0, },
				Input2 = InstanceInput { SourceOp = "Label", Source = "StyledText", Name = "Sticker text", Default = "MAIN STAGE", },
				Input3 = InstanceInput { SourceOp = "Tag", Source = "Width", Name = "Sticker width", Default = 900, },
				Input4 = InstanceInput { SourceOp = "MergeTag", Source = "Center", Name = "Position", Default = { 0.21094, 0.82176 }, },
			},
			Outputs = {
				MainOutput1 = InstanceOutput { SourceOp = "MergeTag", Source = "Output", },
			},
			ViewInfo = GroupInfo { Pos = { 0, 0 } },
			Tools = ordered() {
				Canvas = Background {
					UserControls = ordered() {
						Variant = {
							LINKID_DataType = "Number",
							INPID_InputControl = "ComboControl",
							INP_Integer = true,
							INP_Default = 0,
							INP_MinScale = 0,
							INP_MaxScale = 1,
							CC_LabelPosition = "Horizontal",
							ICS_ControlPage = "Controls",
							LINKS_Name = "Colour variant",
							{ CCS_AddString = "Climb Orange", },
							{ CCS_AddString = "Dark Brown", },
						},
					},
					Inputs = {
						Width = Input { Value = 3840, },
						Height = Input { Value = 2160, },
						UseFrameFormatSettings = Input { Value = 0, },
						Variant = Input { Value = 0, },
						TopLeftRed = Input { Value = 0, },
						TopLeftGreen = Input { Value = 0, },
						TopLeftBlue = Input { Value = 0, },
						TopLeftAlpha = Input { Value = 0, },
					},
				},
				Tag = Background {
					Inputs = {
						Width = Input { Value = 900, },
						Height = Input { Value = 170, },
						UseFrameFormatSettings = Input { Value = 0, },
						TopLeftRed = Input { Value = 0.909804, Expression = "iif(Canvas.Variant == 0, 0.909804, 0.117647)", },
						TopLeftGreen = Input { Value = 0.443137, Expression = "iif(Canvas.Variant == 0, 0.443137, 0.058824)", },
						TopLeftBlue = Input { Value = 0.164706, Expression = "iif(Canvas.Variant == 0, 0.164706, 0.019608)", },
						TopLeftAlpha = Input { Value = 1, },
					},
				},
				Label = TextPlus {
					Inputs = {
						Width = Input { Value = 900, },
						Height = Input { Value = 170, },
						UseFrameFormatSettings = Input { Value = 0, },
						StyledText = Input { Value = "MAIN STAGE", },
						Font = Input { Value = "Montserrat", },
						Style = Input { Value = "Black", },
						Size = Input { Value = 0.162533, },
						CharacterSpacing = Input { Value = 1, },
						Center = Input { Value = { 0.5, 0.5 }, },
						HorizontalLeftCenterRight = Input { Value = 0, },
						HorizontalJustificationNew = Input { Value = 0, },
						VerticalTopCenterBottom = Input { Value = 0, },
						VerticalJustificationNew = Input { Value = 3, },
						Red1 = Input { Value = 0.117647, Expression = "iif(Canvas.Variant == 0, 0.117647, 1)", },
						Green1 = Input { Value = 0.058824, Expression = "iif(Canvas.Variant == 0, 0.058824, 1)", },
						Blue1 = Input { Value = 0.019608, Expression = "iif(Canvas.Variant == 0, 0.019608, 1)", },
						Alpha1 = Input { Value = 1, },
					},
				},
				TagLabel = Merge {
					Inputs = {
						Background = Input { SourceOp = "Tag", Source = "Output", },
						Foreground = Input { SourceOp = "Label", Source = "Output", },
					},
				},
				Pop = Transform {
					Inputs = {
						Input = Input { SourceOp = "TagLabel", Source = "Output", },
						Angle = Input { Value = 4, },
						Size = Input { Value = 1, Expression = "(0.6+0.4*(1+2.70158*(min(max((time-0)/10,0),1)-1)^3+1.70158*(min(max((time-0)/10,0),1)-1)^2))*(1-0.04*((1-min(max((comp.RenderEnd-time)/10,0),1))^2))", },
					},
				},
				MergeTag = Merge {
					Inputs = {
						Background = Input { SourceOp = "Canvas", Source = "Output", },
						Foreground = Input { SourceOp = "Pop", Source = "Output", },
						Center = Input { Value = { 0.21094, 0.82176 }, },
						Blend = Input { Value = 1, Expression = "min(max(time/3,0),1)*(1-((1-min(max((comp.RenderEnd-time)/10,0),1))^2))", },
					},
				},
			},
		},
	},
	ActiveTool = "ClimbGroup_Sticker"
}
